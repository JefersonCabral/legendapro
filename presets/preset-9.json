{
  "name": "preset-9",
  "title": "Preset 9",
  "description": "Referência v8: grotesca pesadíssima (Figtree ExtraBold) com letras coladas, texto rosa em modo DIFERENÇA com o vídeo (rosa no escuro, verde-petróleo no claro, a textura do vídeo aparece invertida dentro da letra); palavra negativa em vermelho ainda maior; cada linha entra com fade de 0,3 s e o bloco sai seco.",
  "fonts": {
    "sans": {
      "file": "Figtree-VF.ttf",
      "axes": {
        "wght": 800
      },
      "tracking": -0.11,
      "space_scale": 0.5
    },
    "hero": {
      "file": "Figtree-VF.ttf",
      "axes": {
        "wght": 800
      },
      "tracking": -0.11,
      "space_scale": 0.5
    },
    "italic": {
      "file": "Figtree-VF.ttf",
      "axes": {
        "wght": 800
      },
      "tracking": -0.11,
      "space_scale": 0.5
    },
    "serif": {
      "file": "Figtree-VF.ttf",
      "axes": {
        "wght": 800
      },
      "tracking": -0.11,
      "space_scale": 0.5
    }
  },
  "layout": {
    "anchor_mode": "center",
    "anchor_y": 0.665,
    "plain_anchor_y": 0.665,
    "safe_width": 0.92,
    "base_size": 0.19,
    "support_scale": 1.0,
    "hero_scale": 1.8,
    "hero_max_width": 0.9,
    "red_scale": 1.3,
    "serif_scale": 1.0,
    "above_align": "left",
    "above_indent": 0.02,
    "below_align": "left",
    "below_indent": 0.0,
    "indent_fit": 1.0,
    "gap_above": 0.075,
    "gap_below": 0.026
  },
  "colors": {
    "text": "#FFC3C4",
    "hero": "#FFC3C4",
    "red": "#FF1B38",
    "accent": "#FFC3C4"
  },
  "effects": {
    "blend": {
      "enabled": true,
      "mode": "difference",
      "opacity": 1.0
    },
    "shadow": {
      "opacity": 0.0,
      "blur": 0.005,
      "offset_y": 0.0
    },
    "gradient": {
      "enabled": false,
      "top": 0.55,
      "full": 0.95,
      "opacity": 0.4,
      "curve": 1.6,
      "color": "#000000"
    },
    "glow": {},
    "anim": {
      "plain": {
        "type": "fade",
        "reveal": "line",
        "duration": 0.3,
        "fade": 0.3,
        "fade_ease": "out_quad",
        "dist": 0.0
      },
      "support": {
        "type": "fade",
        "reveal": "line",
        "duration": 0.3,
        "fade": 0.3,
        "fade_ease": "out_quad",
        "dist": 0.0
      },
      "hero": {
        "type": "fade",
        "reveal": "line",
        "duration": 0.3,
        "fade": 0.3,
        "fade_ease": "out_quad",
        "dist": 0.0
      },
      "serif": {
        "type": "fade",
        "reveal": "line",
        "duration": 0.3,
        "fade": 0.3,
        "fade_ease": "out_quad",
        "dist": 0.0
      }
    },
    "exit": {
      "type": "cut"
    },
    "lead": 0.05
  },
  "rules": {
    "engine": "phrase",
    "emphasis_threshold": 2.0,
    "emphasis_every": 1.6,
    "emphasis_gap": 0.8,
    "phrase_max_words": 5,
    "support_max_words": 3,
    "support_max_chars": 16,
    "chunk_max_words": 3,
    "chunk_max_chars": 16,
    "chunk_pause": 0.25,
    "max_hold": 2.0,
    "case": "keep",
    "strip_punct": ",;:.!?…",
    "hero_number_unit": true,
    "serif_tail": false,
    "article_alone": false,
    "red_auto": true
  },
  "effect_notes": {
    "red": "vermelho ainda maior (como o 'Fail')",
    "circle": "elipse desenhada em volta",
    "underline": "traço desenhado embaixo da linha",
    "box": "caixa chapada atrás da linha",
    "break": "começa um bloco novo depois desta palavra",
    "color": "cor só desta palavra",
    "destaque": "palavra 1,8× maior, misturada com o vídeo em diferença"
  }
}
